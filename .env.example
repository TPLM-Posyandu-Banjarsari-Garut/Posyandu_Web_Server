# Template local development only. Never deploy these sample values.
# Generate DATA_ENCRYPTION_KEY with: openssl rand -hex 32
NODE_ENV=development
PORT=3000
APP_HOST_PORT=3000
LOG_LEVEL=debug

CORS_ORIGIN=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# For host commands, use localhost. Compose builds its internal URL using
# DATABASE_USER, DATABASE_PASSWORD, and DATABASE_NAME with host `postgres`.
DATABASE_URL=postgresql://posyandu:localdevpassword@localhost:5432/posyandu_dev
DATABASE_USER=posyandu
DATABASE_PASSWORD=localdevpassword
DATABASE_NAME=posyandu_dev
DB_PORT=5432
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

DATA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

RESEND_API_KEY=re_replace_me
SENDER_EMAIL=noreply@example.test
CONTACT_NAME=Posyandu Support
CONTACT_WHATSAPP=https://wa.me/620000000000
CONTACT_EMAIL=support@example.test

RATE_LIMIT_GLOBAL_WINDOW_MINUTES=15
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_AUTH_WINDOW_MINUTES=60
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_SIGNIN_WINDOW_MINUTES=15
RATE_LIMIT_SIGNIN_MAX=5
RATE_LIMIT_SIGNUP_WINDOW_MINUTES=60
RATE_LIMIT_SIGNUP_MAX=3
RATE_LIMIT_OTP_REQ_WINDOW_MINUTES=10
RATE_LIMIT_OTP_REQ_MAX=3
RATE_LIMIT_OTP_VERIFY_WINDOW_MINUTES=10
RATE_LIMIT_OTP_VERIFY_MAX=5
RATE_LIMIT_RESET_PWD_WINDOW_MINUTES=60
RATE_LIMIT_RESET_PWD_MAX=3
RATE_LIMIT_DELETE_ACC_WINDOW_MINUTES=60
RATE_LIMIT_DELETE_ACC_MAX=3
RATE_LIMIT_CHANGE_PWD_WINDOW_MINUTES=60
RATE_LIMIT_CHANGE_PWD_MAX=5
RATE_LIMIT_MEDIA_UPLOAD_WINDOW_MINUTES=60
RATE_LIMIT_MEDIA_UPLOAD_MAX=20

R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET_NAME=posyandu-local
R2_PUBLIC_URL=https://assets.example.test

# Optional. KV cache falls back to per-process memory when these are blank.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_KV_NAMESPACE_ID=

MEDIA_UPLOAD_MAX_SIZE_MB=10
MEDIA_UPLOAD_MAX_RAW_SIZE_MB=20
MEDIA_UPLOAD_ALLOWED_EXTENSIONS=jpg,png,webp

# Optional. Still used for Better Auth secondary storage and distributed rate limits.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# UPSTASH_REDIS_URL=

TURNSTILE_SECRET_KEY=skip
CSRF_SECRET=dev-csrf-secret-change-in-production-32chars
CRON_SECRET=replace-me-with-a-long-random-secret
SESSION_EXPIRES_IN=604800
SESSION_UPDATE_AGE=86400
SESSION_COOKIE_CACHE_ENABLED=false
SESSION_COOKIE_CACHE_MAX_AGE=300

# Leave blank locally to disable web push. Generate a dedicated key pair for production.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.test
